# Firebase (free Spark plan) — Project settings > Your apps > Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server-only (set in Vercel > Project > Settings > Environment Variables, NOT prefixed with VITE_)
GEMINI_API_KEY=
# Optional: override the Gemini model name
GEMINI_MODEL=gemini-2.5-flash
